sampler BaseTextureSampler : register(s0);
float strength : register( c0 );
float zoom     : register( c1 );

float4 main(float2 tex : TEXCOORD0) : COLOR
{
        // fisheye bulge amount (0 = none, 1 = full hemisphere)
        strength = 0.8;

        // zoom to pull image in and avoid black corners
        zoom = 1.0;


        float2 uv = (tex - 0.5) * 2.0;

        float d = length(uv) / zoom;
        float r2 = saturate(d * d);

        float f = 0;

        //only compute perspective term if needed
        if( zoom == 0.0 ){
                f = 1;
        }else{
                f = 1;
        };

        float z = sqrt(1.0 - r2 * strength);
        float r = (d > 0.0) ? atan2(d, z) / 1.5707963 : 0.0;

        float2 newUV = (d > 0.0) ? uv * (r / d) : uv;

        // get the right pixel for the current position
        float x = newUV.x * 0.5 + 0.5;
        float y = newUV.y * 0.5 + 0.5;

        float3 inputDistord = tex2D(BaseTextureSampler, float2(x,y));


        return float4(inputDistord.r,inputDistord.g,inputDistord.b,1);
}